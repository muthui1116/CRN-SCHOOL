<%- include('partials/header') %>

<div class="container learner-page py-5">
  <div class="learner-hero d-flex flex-column flex-md-row justify-content-between align-items-start gap-4 mb-4">
    <div>
      <p class="learner-eyebrow mb-2"><i class="fas fa-compass me-2"></i>Student portal</p>
      <h1 class="h3 mb-2">Good to see you, <span><%= user.name || user.email %></span></h1>
      <p class="learner-hero-copy mb-0">Your learning progress, assessment record, and homework in one place.</p>
    </div>
    <div class="learner-actions d-flex flex-column align-items-start align-items-md-end gap-3">
      <div>
        <span class="learner-chip learner-chip-primary me-1"><i class="fas fa-user-graduate me-1"></i>Learner</span>
        <% const resolvedGrade = userProfile?.grade || user.grade; %>
        <% if (resolvedGrade) { %>
          <span class="learner-chip"><i class="fas fa-layer-group me-1"></i>Grade <%= resolvedGrade %></span>
        <% } %>
      </div>
        <div class="learner-controls d-flex align-items-center gap-2 flex-wrap">
        <label for="termSelect" class="visually-hidden">Select term</label>
        <select id="termSelect" class="form-select form-select-sm" onchange="window.location.href='/learner?term=' + this.value + '&assessment=' + (document.querySelector('[data-assessment-active]').dataset.assessment)">
          <% [1,2,3].forEach(term => { %>
            <option value="<%= term %>" <%= String(term) === String(selectedTerm) ? 'selected' : '' %> >Term <%= term %></option>
          <% }) %>
        </select>
        <div class="btn-group ms-2" role="group" aria-label="Assessment type">
          <a href="/learner?assessment=continous&term=<%= selectedTerm %>" class="btn btn-sm <%= assessmentType === 'continous' ? 'btn-primary' : 'btn-outline-primary' %>" data-assessment="continous" data-assessment-active="true">
            <i class="fas fa-chart-line me-1"></i>Continous ass
          </a>
          <a href="/learner?assessment=summative&term=<%= selectedTerm %>" class="btn btn-sm <%= assessmentType === 'summative' ? 'btn-primary' : 'btn-outline-secondary' %>">
            <i class="fas fa-clipboard-list me-1"></i>Summative ass
          </a>
        </div>
        <a href="/learner/homework" class="btn btn-sm btn-success ms-2 w-100 w-md-auto">
          <i class="fas fa-book me-1"></i>My Homework
        </a>
      </div>
    </div>
  </div>

  <div class="row gy-4">
    <div class="col-12 col-xl-4">
      <div class="card learner-card profile-card h-100">
        <div class="card-body">
          <div class="section-heading mb-4">
            <span class="section-icon"><i class="fas fa-id-card"></i></span>
            <div><p class="section-kicker mb-1">Account overview</p><h5 class="card-title mb-0">My Profile</h5></div>
          </div>
          <dl class="row mb-0">
            <dt class="col-sm-5 text-muted">Name</dt>
            <dd class="col-sm-7"><%= userProfile?.name || user.name || 'N/A' %></dd>

            <dt class="col-sm-5 text-muted">Email</dt>
            <dd class="col-sm-7"><%= userProfile?.email || user.email || 'N/A' %></dd>

            <dt class="col-sm-5 text-muted">Phone</dt>
            <dd class="col-sm-7"><%= userProfile?.phone || 'N/A' %></dd>

            <dt class="col-sm-5 text-muted">Grade</dt>
            <dd class="col-sm-7"><%= userProfile?.grade || user.grade || 'N/A' %></dd>

            <dt class="col-sm-5 text-muted">Assessment #</dt>
            <dd class="col-sm-7"><%= userProfile?.assessment_number || user.assessment_number || 'N/A' %></dd>

            <dt class="col-sm-5 text-muted">Joined</dt>
            <dd class="col-sm-7"><%= userProfile?.date_created ? new Date(userProfile.date_created).toLocaleDateString() : 'N/A' %></dd>
          </dl>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-8">
      <div class="card learner-card results-card">
        <div class="card-body">
          <div class="results-heading d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
              <p class="section-kicker mb-1">Academic record</p>
              <h5 class="card-title mb-1">My Exam Results</h5>
              <small class="text-muted">Your performance across all subjects.</small>
            </div>
            <span class="results-term">Term <%= selectedTerm %></span>
          </div>

          <% const hasAssessmentResults = learnerRecord || (subjectDefinitions && subjectDefinitions.length > 0); %>
          <% if (!hasAssessmentResults) { %>
            <div class="alert alert-warning mb-0">
              <strong>No exam results recorded yet.</strong><br>
              <small>Assessment #: <%= userProfile?.assessment_number || 'Not set' %></small>
            </div>
          <% } else { %>
            <% const displayedSubjects = subjectDefinitions && subjectDefinitions.length ? subjectDefinitions : [
                    { key: 'english', label: 'English' },
                    { key: 'kiswahili', label: 'Kiswahili' },
                    { key: 'mathematics', label: 'Mathematics' },
                    { key: 'integrated_science', label: 'Integrated Science' },
                    { key: 'agriculture', label: 'Agriculture' },
                    { key: 'social_studies', label: 'Social Studies' },
                    { key: 'cre', label: 'CRE' },
                    { key: 'pre_technical', label: 'Pre-Technical' },
                    { key: 'creative_arts', label: 'Art and Craft' }
                  ]; %>

            <% if (assessmentType === 'summative') { %>
              <div class="d-none d-md-block table-responsive">
                <table class="table learner-results-table table-bordered align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Learning Area</th>
                      <th>Code</th>
                      <th>Mark</th>
                      <th>Performance Level</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% displayedSubjects.forEach(subject => { %>
                      <tr>
                        <td class="fw-semibold"><%= subject.label %></td>
                        <td><%= learnerSubjectRows[subject.key]?.code || subject.code || subject.key %></td>
                        <td><%= learnerSubjectRows[subject.key]?.mark ?? '—' %></td>
                        <td><span class="badge bg-info"><%= learnerSubjectRows[subject.key]?.pl || '—' %></span></td>
                      </tr>
                    <% }) %>
                    <tr class="table-primary fw-bold">
                      <td>Overall Average</td>
                      <td></td>
                      <td><%= (learnerRecord && learnerRecord.evrg) ? learnerRecord.evrg : '—' %></td>
                      <td><span class="badge bg-success"><%= (learnerRecord && learnerRecord.evrg_pl) ? learnerRecord.evrg_pl : '—' %></span></td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div class="d-block d-md-none">
                <div class="row row-cols-1 g-2">
                  <% displayedSubjects.forEach(subject => { %>
                    <div class="col">
                      <div class="card shadow-sm">
                        <div class="card-body p-3">
                          <small class="d-block text-muted"><%= subject.label %></small>
                          <div class="d-flex justify-content-between align-items-center mb-2">
                            <div><strong>Code:</strong> <%= learnerSubjectRows[subject.key]?.code || subject.code || subject.key %></div>
                            <div><strong>Mark:</strong> <%= learnerSubjectRows[subject.key]?.mark ?? '—' %></div>
                          </div>
                          <div><strong>PL:</strong> <span class="badge bg-info"><%= learnerSubjectRows[subject.key]?.pl || '—' %></span></div>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                  <div class="col">
                    <div class="card shadow-sm">
                      <div class="card-body p-3">
                        <small class="d-block text-muted">Overall Average</small>
                        <div class="d-flex justify-content-between align-items-center">
                          <strong><%= (learnerRecord && learnerRecord.evrg) ? learnerRecord.evrg : '—' %></strong>
                          <span class="badge bg-success"><%= (learnerRecord && learnerRecord.evrg_pl) ? learnerRecord.evrg_pl : '—' %></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% } else { %>
              <div class="d-none d-md-block table-responsive">
                <table class="table learner-results-table table-bordered align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Learning Area</th>
                      <th>Code</th>
                      <th>Strand</th>
                      <th>Sub-strand</th>
                      <th class="text-center">EE</th>
                      <th class="text-center">AE</th>
                      <th class="text-center">ME</th>
                      <th class="text-center">BE</th>
                      <th>Reflection</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% displayedSubjects.forEach(subject => { %>
                      <% const subjectRow = learnerSubjectRows[subject.key] || {}; %>
                      <% const entries = subjectRow.entries || [{ strand: subjectRow.strand, sub_strand: subjectRow.sub_strand, reflection: subjectRow.reflection, ee: subjectRow.ee, ae: subjectRow.ae, me: subjectRow.me, be: subjectRow.be }]; %>
                      <% entries.forEach((entry, entryIndex) => { %>
                        <tr>
                          <td class="fw-semibold"><%= entryIndex === 0 ? subject.label : '' %></td>
                          <td><%= entryIndex === 0 ? subject.key : '' %></td>
                          <td><%= entry.strand || (entryIndex === 0 ? (subjectRow.strand || '—') : '') %></td>
                          <td><%= entry.sub_strand || '—' %></td>
                          <td class="text-center"><%= entry.ee ? '✔' : '—' %></td>
                          <td class="text-center"><%= entry.ae ? '✔' : '—' %></td>
                          <td class="text-center"><%= entry.me ? '✔' : '—' %></td>
                          <td class="text-center"><%= entry.be ? '✔' : '—' %></td>
                          <td><%= entry.reflection || '—' %></td>
                        </tr>
                      <% }) %>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <div class="d-block d-md-none">
                <div class="row row-cols-1 g-2">
                  <div class="col">
                    <div class="learner-mobile-results card shadow-sm">
                      <div class="card-body p-3">
                        <div class="row row-cols-1 g-3">
                          <% displayedSubjects.forEach(subject => { %>
                            <% const subjectRow = learnerSubjectRows[subject.key] || {}; %>
                            <% const entries = subjectRow.entries || [{ strand: subjectRow.strand, sub_strand: subjectRow.sub_strand, reflection: subjectRow.reflection, ee: subjectRow.ee, ae: subjectRow.ae, me: subjectRow.me, be: subjectRow.be }]; %>
                            <% entries.forEach((entry, entryIndex) => { %>
                              <div class="col">
                                <% if (entryIndex === 0) { %>
                                  <small class="d-block text-muted"><%= subject.label %></small>
                                  <div><strong><%= subject.key %></strong></div>
                                <% } %>
                                <div class="small mt-2">
                                  <strong>Strand:</strong> <%= entry.strand || '—' %><br>
                                  <strong>Sub-strand:</strong> <%= entry.sub_strand || '—' %>
                                </div>
                                <div class="small mt-2">
                                  EE: <%= entry.ee ? '✔' : '—' %><br>
                                  AE: <%= entry.ae ? '✔' : '—' %><br>
                                  ME: <%= entry.me ? '✔' : '—' %><br>
                                  BE: <%= entry.be ? '✔' : '—' %>
                                </div>
                                <div class="small text-truncate" style="max-width: 220px;">
                                  <strong>Ref:</strong> <%= entry.reflection || '—' %>
                                </div>
                              </div>
                            <% }) %>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          <% } %>

          <% if (homeworkList && homeworkList.length > 0) { %>
            <div class="homework-section mt-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">Homework Assignments</h5>
                <small class="text-muted"><%= homeworkList.length %> assignment(s)</small>
              </div>
              <% homeworkList.forEach(hw => { %>
                <div class="card mb-3 shadow-sm">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                      <div>
                        <h6 class="fw-semibold mb-1">
                          <% if (hw.subject) { %>
                            <span class="badge bg-primary me-2"><%= hw.subject.charAt(0).toUpperCase() + hw.subject.slice(1) %></span>
                          <% } %>
                          Homework for Grade <%= hw.grade %>
                        </h6>
                        <p class="mb-1 text-muted small">Assigned by <strong><%= hw.teacher_name %></strong> on <%= new Date(hw.created_at).toLocaleDateString() %></p>
                        <p class="mb-0"><%= hw.task_description || 'No task description provided.' %></p>
                      </div>
                      <div class="text-end d-grid gap-2 d-md-flex justify-content-end">
                        <% if (hw.document_path) { %>
                          <a href="/<%= hw.document_path %>" class="btn btn-sm btn-outline-secondary mb-2 w-100 w-md-auto" download>
                            <i class="fas fa-download me-1"></i>Download
                          </a>
                        <% } %>
                        <a href="/learner/homework/<%= hw.id %>" class="btn btn-sm btn-primary w-100 w-md-auto">
                          <i class="fas fa-arrow-right me-1"></i>Open
                        </a>
                      </div>
                    </div>
                    <% if (hw.submission_id) { %>
                      <div class="mt-3">
                        <span class="badge bg-success">Submitted</span>
                        <% if (hw.teacher_score !== null) { %>
                          <span class="badge bg-success"><%= hw.teacher_score %>%</span>
                        <% } %>
                        <% if (hw.teacher_feedback) { %>
                          <span class="badge bg-info">Feedback available</span>
                        <% } %>
                      </div>
                    <% } else { %>
                      <div class="mt-3">
                        <span class="badge bg-warning text-dark">Pending submission</span>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="alert alert-light mt-4">
              <p class="mb-0">No homework assignments are currently available for your grade.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>

<style>
  .table-primary {
    background-color: rgba(13, 110, 253, 0.1);
  }
</style>


