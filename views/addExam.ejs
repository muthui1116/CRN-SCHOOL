        const deleteStrandEntry = (subjectKey, item) => {
          const list = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
          if (!list || !item) return;
          // determine which strand index is being removed
          const removedIndex = Number(item.dataset.strandIndex || (String(item.dataset.entryId || '').split('_').pop())) || null;
          item.remove();
          // renumber remaining strands
          renumberStrandEntries(subjectKey);

          // adjust parentStrandIndex on substrand items so color binding persists
          const substrands = Array.from(document.querySelectorAll(`.substrand-list[data-subject="${subjectKey}"] .substrand-item`));
          const strands = Array.from(document.querySelectorAll(`.strand-list[data-subject="${subjectKey}"] .strand-item`));
          const strandCount = strands.length;
          substrands.forEach(s => {
            const p = s.dataset.parentStrandIndex ? Number(s.dataset.parentStrandIndex) : null;
            if (!p || removedIndex === null) return;
            if (p === removedIndex) {
              // reassign to previous strand if exists, else to first available, else remove binding
              if (strandCount >= removedIndex) {
                s.dataset.parentStrandIndex = String(removedIndex);
              } else if (strandCount > 0) {
                s.dataset.parentStrandIndex = String(Math.max(1, removedIndex - 1));
              } else {
                delete s.dataset.parentStrandIndex;
              }
            } else if (p > removedIndex) {
              s.dataset.parentStrandIndex = String(p - 1);
            }
          });

          renumberSubstrandEntries(subjectKey);
          saveFormState();
        };

        const deleteSubstrandEntry = (subjectKey, item) => {
          const list = document.querySelector(`.substrand-list[data-subject="${subjectKey}"]`);
          if (!list || !item) return;
          const entryId = item.dataset.entryId;
          item.remove();
          document.querySelectorAll(`.substrand-checklist[data-subject="${subjectKey}"] .substrand-cell[data-entry-id="${entryId}"]`).forEach(cell => cell.remove());
          document.querySelectorAll(`.substrand-reflection-list[data-subject="${subjectKey}"] .reflection-cell[data-entry-id="${entryId}"]`).forEach(cell => cell.remove());
          renumberSubstrandEntries(subjectKey);
          syncSubstrandEntryHeights(subjectKey);
          saveFormState();
        };

        const bindEditAction = (item, { subjectKey, kind, entryId, label }) => {
          const textNode = item.querySelector('.entry-text');
          if (!textNode || textNode.dataset.editBound === 'true') return;
          textNode.dataset.editBound = 'true';
          textNode.tabIndex = 0;
          textNode.style.cursor = 'pointer';

          textNode.addEventListener('click', event => {
            event.preventDefault();
            event.stopPropagation();

            const currentValue = item.querySelector('input[type="hidden"]')?.value || '';
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control form-control-sm inline-entry-edit';
            input.value = currentValue;
            input.setAttribute('aria-label', `Edit ${kind} value`);

            const parent = textNode.parentNode;
            if (parent) {
              parent.replaceChild(input, textNode);
            }
            input.focus();
            input.select();

            const commitEdit = () => {
              const nextValue = String(input.value || '').trim();
              const finalValue = nextValue || currentValue;
              const hidden = item.querySelector('input[type="hidden"]');
              if (hidden) hidden.value = finalValue;

              const currentLabel = item.dataset.label || label;
              const newText = document.createElement('div');
              newText.className = 'entry-text small fw-semibold';
              newText.innerHTML = `${currentLabel}. ${escapeHtml(finalValue)}`;
              newText.tabIndex = 0;
              newText.style.cursor = 'pointer';
              parent.replaceChild(newText, input);
              bindEditAction(item, { subjectKey, kind, entryId, label: currentLabel });
              saveFormState();
            };

            input.addEventListener('keydown', event => {
              if (event.key === 'Enter') {
                event.preventDefault();
                commitEdit();
              }
              if (event.key === 'Escape') {
                event.preventDefault();
                input.value = currentValue;
                commitEdit();
              }
            });

            input.addEventListener('blur', commitEdit);
          });
        };

        const addStrandEntry = (subjectKey, value, sourceInput) => {
          const strandList = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
          const subList = document.querySelector(`.substrand-list[data-subject="${subjectKey}"]`);
          if (!strandList) return;

          if (subList) {
            subList.dataset.substrandIndex = '0';
          }

          const index = Number(strandList.dataset.strandIndex || '0') + 1;
          strandList.dataset.strandIndex = String(index);
          const label = toRoman(index);
          const safe = escapeHtml(value);
          const item = document.createElement('div');
          item.className = 'strand-item border rounded';
          item.dataset.entryId = `${subjectKey}_strand_${index}`;
          item.dataset.label = label;
          // color class for this strand (1-2 cycle)
          const colorIndex = ((index - 1) % 2) + 1;
          item.dataset.strandIndex = String(index);
          item.classList.add(`strand-color-${colorIndex}`);
          item.innerHTML = `<div class="entry-text small fw-semibold">${label}. ${safe}</div>`;
          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = `${subjectKey}_strand[]`;
          hidden.value = value;
          item.appendChild(hidden);

          const deleteButton = document.createElement('button');
          deleteButton.type = 'button';
          deleteButton.className = 'entry-delete-btn';
          deleteButton.title = 'Delete strand';
          deleteButton.innerHTML = '&times;';
          deleteButton.addEventListener('click', event => {
            event.stopPropagation();
            deleteStrandEntry(subjectKey, item);
          });
          const actions = document.createElement('div');
          actions.className = 'entry-actions';
          actions.appendChild(deleteButton);
          item.appendChild(actions);

          strandList.appendChild(item);
          bindEditAction(item, { subjectKey, kind: 'strand', entryId: item.dataset.entryId, label });
          saveFormState();
          if (sourceInput) sourceInput.value = '';
        };

        const addSubstrandEntry = (subjectKey, value, sourceInput) => {
          const list = document.querySelector(`.substrand-list[data-subject="${subjectKey}"]`);
          if (!list) return;
          const index = Number(list.dataset.substrandIndex || '0') + 1;
          list.dataset.substrandIndex = String(index);
          const label = toRoman(index);
          const safe = escapeHtml(value);
          const entryId = `${subjectKey}_line_${index}`;

          const item = document.createElement('div');
          item.className = 'substrand-item border rounded';
          item.dataset.entryId = entryId;
          item.dataset.label = label;
          item.innerHTML = `<div class="entry-text small fw-semibold">${label}. ${safe}</div>`;
          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = `${entryId}_text`;
          hidden.value = value;
          item.appendChild(hidden);

          const deleteButton = document.createElement('button');
          deleteButton.type = 'button';
          deleteButton.className = 'entry-delete-btn';
          deleteButton.title = 'Delete sub-strand';
          deleteButton.innerHTML = '&times;';
          deleteButton.addEventListener('click', event => {
            event.stopPropagation();
            deleteSubstrandEntry(subjectKey, item);
          });
          const actions = document.createElement('div');
          actions.className = 'entry-actions';
          actions.appendChild(deleteButton);
          item.appendChild(actions);

          list.appendChild(item);
          bindEditAction(item, { subjectKey, kind: 'substrand', entryId, label });

          // bind this substrand to the most recent strand's color (if any)
          const strandList = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
          const strandCount = strandList ? strandList.querySelectorAll('.strand-item').length : 0;
          const parentIndex = strandCount > 0 ? strandCount : 1;
          const colorIndex = ((parentIndex - 1) % 2) + 1;
          item.dataset.parentStrandIndex = String(parentIndex);
          item.classList.add(`strand-color-${colorIndex}`);

          ['ee','ae','me','be'].forEach(type => {
            const container = document.querySelector(`.substrand-checklist[data-subject="${subjectKey}"][data-type="${type}"]`);
            if (!container) return;
            const wrap = document.createElement('div');
            wrap.className = 'substrand-cell border rounded mb-2';
            wrap.dataset.entryId = entryId;
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.name = `${entryId}_${type}`;
            cb.value = '1';
            wrap.appendChild(cb);
            container.appendChild(wrap);
          });

          const reflContainer = document.querySelector(`.substrand-reflection-list[data-subject="${subjectKey}"]`);
          if (reflContainer) {
            const wrap = document.createElement('div');
            wrap.className = 'reflection-cell border rounded mb-2';
            wrap.dataset.entryId = entryId;
            const ta = document.createElement('textarea');
            ta.className = 'substrand-reflection-input';
            ta.name = `${entryId}_reflection`;
            ta.rows = 1;
            ta.placeholder = 'Reflection';
            wrap.appendChild(ta);
            reflContainer.appendChild(wrap);
          }

          syncSubstrandEntryHeights(subjectKey);
          saveFormState();
          if (sourceInput) sourceInput.value = '';
        };

        const syncSubstrandEntryHeights = subjectKey => {
          const subList = document.querySelector(`.substrand-list[data-subject="${subjectKey}"]`);
          if (!subList) return;

          const items = Array.from(subList.querySelectorAll('.substrand-item'));
          items.forEach(item => {
            const entryId = item.dataset.entryId;
            if (!entryId) return;

            const cells = [
              ...document.querySelectorAll(`.substrand-checklist[data-subject="${subjectKey}"] .substrand-cell[data-entry-id="${entryId}"]`),
              ...document.querySelectorAll(`.substrand-reflection-list[data-subject="${subjectKey}"] .reflection-cell[data-entry-id="${entryId}"]`)
            ];
            if (!cells.length) return;

            [item, ...cells].forEach(el => {
              if (el) el.style.height = 'auto';
            });

            const maxHeight = Math.max(item.offsetHeight, ...cells.map(el => el.offsetHeight));
            const targetHeight = `${maxHeight}px`;
            item.style.height = targetHeight;
            cells.forEach(el => { el.style.height = targetHeight; });
          });
        };

        const initStrandEditors = () => {
          const editors = document.querySelectorAll('input[name$="_strand"]');
          editors.forEach(input => {
            if (input._strandInit) return; input._strandInit = true;
            input.addEventListener('keydown', event => {
              const isEnterKey = event.key === 'Enter' || event.keyCode === 13;
              if (!isEnterKey) return;
              event.preventDefault();
              const subjectKey = input.dataset.subject || String(input.name || '').replace(/_strand$/, '');
              const value = String(input.value || '').trim();
              if (!value) return;
              addStrandEntry(subjectKey, value, input);
            });
          });
        };

        const initSubstrandEditors = () => {
          const editors = document.querySelectorAll('.substrand-input');
          editors.forEach(input => {
            if (input._substrandInit) return; input._substrandInit = true;
            input.addEventListener('keydown', event => {
              const isEnterKey = event.key === 'Enter' || event.keyCode === 13;
              if (!isEnterKey) return;
              event.preventDefault();
              const subjectKey = input.dataset.subject || String(input.name || '').replace(/_strand$/, '');
              const value = String(input.value || '').trim();
              if (!value) return;
              addSubstrandEntry(subjectKey, value, input);
            });
          });
        };

        const bindAddButtons = () => {
          document.querySelectorAll('.add-entry-button').forEach(button => {
            if (button._addButtonInit) return; button._addButtonInit = true;
            button.addEventListener('click', () => {
              const kind = button.dataset.kind;
              const subjectKey = button.dataset.subject;
              if (!subjectKey || !kind) return;
              const inputSelector = kind === 'strand' ? `input[name="${subjectKey}_strand"]` : `.substrand-input[data-subject="${subjectKey}"]`;
              const input = document.querySelector(inputSelector);
              if (!input) return;
              const value = String(input.value || '').trim();
              if (!value) return;
              if (kind === 'strand') {
                addStrandEntry(subjectKey, value, input);
              } else {
                addSubstrandEntry(subjectKey, value, input);
              }
              input.focus();
            });
          });
        };

        const updateSubstrandSpacers = () => {
          document.querySelectorAll('.substrand-spacer').forEach(spacer => spacer.remove());
          document.querySelectorAll('.substrand-checklist, .substrand-reflection-list').forEach(container => {
            container.style.marginTop = '0';
            container.style.paddingTop = '0';
            container.style.alignItems = 'stretch';
          });
        };

        // initialize editors now and whenever subjects change
        initStrandEditors();
        initSubstrandEditors();
        bindAddButtons();
        updateSubstrandSpacers();
        window.addEventListener('resize', () => {
          updateSubstrandSpacers();
          examSubjects.forEach(subject => syncSubstrandEntryHeights(subject.key));
        });

        initializeSubjectRows();

        document.addEventListener('input', event => {
          if (!event.target.matches('.occasion-input, .strand-input, .substrand-input, .substrand-reflection-input, input[name$="_cat1"], input[name$="_cat2"], input[name$="_main"]')) return;
          if (event.target.matches('.occasion-input')) {
            clampMarkInput(event.target);
            updateFinal();
          }
          saveFormState();
        });

        let skipSaveOnUnload = false;
        const examForm = document.querySelector('form[action="/exams/add"]');
        if (examForm) {
          examForm.addEventListener('submit', () => {
            skipSaveOnUnload = true;
            localStorage.removeItem(getStateKey());
          });
        }

        window.addEventListener('beforeunload', event => {
          if (!skipSaveOnUnload) {
            saveFormState();
          }
        });

        const restored = loadFormState();
        if (!restored && learnerSelect) {
          if (learnerSelect.value) {
            populateLearnerScores(learnerSelect.value);
          } else if (window.location.search.includes('learner_id=')) {
            const params = new URLSearchParams(window.location.search);
            const learnerId = params.get('learner_id');
            if (learnerId) {
              learnerSelect.value = learnerId;
              populateLearnerScores(learnerId);
            }
          }
        }

        const clearAllFields = () => {
          if (!confirm('Clear all fields? This will reset input, dynamic entries, and saved form state.')) return;
          const form = document.querySelector('form');
          if (!form) return;

          form.querySelectorAll('input,textarea,select').forEach(el => {
            if (el.type === 'checkbox' || el.type === 'radio') {
              el.checked = false;
            } else if (el.tagName === 'SELECT') {
              el.value = '';
            } else {
              el.value = '';
            }
          });

          examSubjects.forEach(subject => {
            const row = document.querySelector(`.subject-row[data-subject="${subject.key}"]`);
            if (row) setRowState(row, false);

            const strandList = document.querySelector(`.strand-list[data-subject="${subject.key}"]`);
            if (strandList) {
              strandList.innerHTML = '';
              strandList.dataset.strandIndex = '0';
            }

            const subList = document.querySelector(`.substrand-list[data-subject="${subject.key}"]`);
            if (subList) {
              subList.innerHTML = '';
              subList.dataset.substrandIndex = '0';
            }

            ['ee','ae','me','be'].forEach(type => {
              const container = document.querySelector(`.substrand-checklist[data-subject="${subject.key}"][data-type="${type}"]`);
              if (container) container.innerHTML = '';
            });

            const reflectionList = document.querySelector(`.substrand-reflection-list[data-subject="${subject.key}"]`);
            if (reflectionList) reflectionList.innerHTML = '';
          });

          if (selectedSubjectInputs) selectedSubjectInputs.innerHTML = '';
          if (subjectButtonList) subjectButtonList.innerHTML = '';

          const prefix = `exam_add_${gradeValue}_${selectedTermValue}_${assessmentTypeValue}_`;
          for (let i = localStorage.length - 1; i >= 0; i--) {
            const key = localStorage.key(i);
            if (typeof key === 'string' && key.startsWith(prefix)) {
              localStorage.removeItem(key);
            }
          }

          updateSubjectOptions();
          updateSubjectState(false);
          updateFinal();
          saveFormState();
        };

        const clearAllBtn = document.getElementById('clearAllBtn');
        if (clearAllBtn) clearAllBtn.addEventListener('click', clearAllFields);

        const form = document.querySelector('form');
        if (form) {
          form.addEventListener('submit', () => {
            if (gradeSelect) {
              gradeInput.value = gradeSelect.value;
            }
            if (!skipSaveOnUnload) saveFormState();
          });
        }
      </script>
    </div>
  </div>
</div>

