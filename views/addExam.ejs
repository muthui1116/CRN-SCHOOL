<%- include('partials/header') %>

<div class="container py-5">
  <div class="card shadow-sm border-0">
    <div class="card-body">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
          <h3 class="mb-1">Add Exam Result</h3>
          <p class="text-muted mb-0">Grade <strong><%= grade %></strong> • Term <strong><%= selectedTerm %></strong></p>
        </div>
        <a href="/exams?grade=<%= grade %>&term=<%= selectedTerm %>" class="btn btn-outline-secondary btn-sm w-100 w-md-auto">Back to results</a>
      </div>

      <form action="/exams/add" method="POST">
        <input type="hidden" name="grade" value="<%= grade %>">
        <input type="hidden" name="term" value="<%= selectedTerm %>">
        <input type="hidden" name="assessment_type" value="<%= assessmentType || 'continous' %>">

        <div class="row gx-3 mb-4">
          <div class="col-12 col-lg-6">
            <label class="form-label fw-semibold">Grade</label>
            <select id="gradeSelect" class="form-select form-select-sm" required>
              <% for (let i = 1; i <= 9; i++) { %>
                <option value="<%= i %>" <%= String(grade || 1) === String(i) ? 'selected' : '' %>>Grade <%= i %></option>
              <% } %>
            </select>
            <div class="form-text">Choose the grade and manage the subjects for this result sheet.</div>
          </div>
          <div class="col-12 col-lg-6">
            <label class="form-label fw-semibold">Learner</label>
            <select name="learner_id" class="form-select form-select-sm" required>
              <option value="">Select learner</option>
              <% if ((learners||[]).length === 0) { %>
                <option value="" disabled>No learners found for this grade.</option>
              <% } else { %>
                <% learners.forEach(l => { %>
                  <option value="<%= l.id %>" <%= selectedLearnerId && String(selectedLearnerId) === String(l.id) ? 'selected' : '' %>><%= l.name %> (<%= l.assessment_number || 'No assessment #' %>)</option>
                <% }) %>
              <% } %>
            </select>
            <div class="form-text">Choose the learner whose term result you want to record.</div>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-12 col-lg-8">
            <label class="form-label fw-semibold">Learning Areas</label>
            <div class="d-flex flex-wrap gap-2 mb-3" id="subjectButtonList"></div>
            <div class="input-group input-group-sm">
              <select id="subjectSelect" class="form-select form-select-sm">
                <option value="">Add a learning area</option>
              </select>
              <button type="button" id="addSubjectBtn" class="btn btn-outline-primary">Add</button>
            </div>
            <div class="form-text">Click a learning area pill to remove it, or use the dropdown to add one back.</div>
          </div>
        </div>

        <div id="selectedSubjectInputs"></div>

        <div class="table-responsive shadow-sm rounded overflow-auto">
          <% const examSubjects = subjectDefinitions && subjectDefinitions.length ? subjectDefinitions : [
                { key: 'english', label: 'English' },
                { key: 'kiswahili', label: 'Kiswahili' },
                { key: 'mathematics', label: 'Mathematics' },
                { key: 'integrated_science', label: 'Integrated Science' },
                { key: 'agriculture', label: 'Agriculture' },
                { key: 'social_studies', label: 'Social Studies' },
                { key: 'cre', label: 'CRE' },
                { key: 'pre_technical', label: 'Pre-Technical' },
                { key: 'creative_arts', label: 'Art and Craft' }
              ]; %>

          <% if (assessmentType === 'continous') { %>
            <table class="table table-bordered mb-0 align-middle">
              <thead class="table-secondary">
                <tr>
                  <th class="fw-semibold">Learning Area</th>
                  <th class="fw-semibold">Strand</th>
                  <th class="fw-semibold">Sub-strand</th>
                  <th class="text-center fw-semibold">EE</th>
                  <th class="text-center fw-semibold">AE</th>
                  <th class="text-center fw-semibold">ME</th>
                  <th class="text-center fw-semibold">BE</th>
                  <th class="fw-semibold">Reflection</th>
                </tr>
              </thead>
              <tbody>
                <% examSubjects.forEach(subject => { %>
                  <tr class="subject-row" data-subject="<%= subject.key %>">
                    <td class="fw-semibold align-top">
                      <span><%= subject.label %></span>
                      <input type="hidden" name="selected_subjects[]" value="<%= subject.key %>">
                      <!-- keep existing score inputs as hidden to preserve backend behavior -->
                      <input type="hidden" name="<%= subject.key %>_cat1">
                      <input type="hidden" name="<%= subject.key %>_cat2">
                      <input type="hidden" name="<%= subject.key %>_main">
                    </td>
                    <td class="align-top">
                      <div class="input-group input-group-sm mb-2 input-with-action">
                        <input type="text" name="<%= subject.key %>_strand" class="form-control strand-input" data-subject="<%= subject.key %>" placeholder="e.g. Communication" autocomplete="off">
                        <button type="button" class="btn btn-outline-secondary add-entry-button" data-subject="<%= subject.key %>" data-kind="strand" aria-label="Add strand">Add</button>
                      </div>
                      <div class="strand-list list-group list-group-flush" data-subject="<%= subject.key %>" data-strand-index="0"></div>
                    </td>
                    <td class="align-top">
                      <div class="substrand-editor" data-subject="<%= subject.key %>">
                        <div class="input-group input-group-sm mb-2 input-with-action">
                          <input type="text" class="form-control substrand-input" data-subject="<%= subject.key %>" placeholder="Type a sub-strand and press Enter or click Add" autocomplete="off">
                          <button type="button" class="btn btn-outline-secondary add-entry-button" data-subject="<%= subject.key %>" data-kind="substrand" aria-label="Add sub-strand">Add</button>
                        </div>
                        <div class="substrand-list list-group list-group-flush" data-subject="<%= subject.key %>" data-substrand-index="0"></div>
                      </div>
                    </td>
                    <td class="align-top text-center">
                      <div class="substrand-checklist" data-subject="<%= subject.key %>" data-type="ee"></div>
                    </td>
                    <td class="align-top text-center">
                      <div class="substrand-checklist" data-subject="<%= subject.key %>" data-type="ae"></div>
                    </td>
                    <td class="align-top text-center">
                      <div class="substrand-checklist" data-subject="<%= subject.key %>" data-type="me"></div>
                    </td>
                    <td class="align-top text-center">
                      <div class="substrand-checklist" data-subject="<%= subject.key %>" data-type="be"></div>
                    </td>
                    <td class="align-top">
                      <div class="substrand-reflection-list" data-subject="<%= subject.key %>"></div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <table class="table table-bordered mb-0 align-middle">
              <thead class="table-secondary">
                <tr>
                  <th class="fw-semibold">Learning Area</th>
                  <th class="text-center fw-semibold">CAT1</th>
                  <th class="text-center fw-semibold">CAT2</th>
                  <th class="text-center fw-semibold">Main</th>
                  <th class="text-center fw-semibold">Final</th>
                </tr>
              </thead>
              <tbody>
                <% examSubjects.forEach(subject => { %>
                  <tr class="subject-row" data-subject="<%= subject.key %>">
                    <td class="fw-semibold">
                      <span><%= subject.label %></span>
                    </td>
                    <td class="text-center"><input type="number" name="<%= subject.key %>_cat1" class="form-control form-control-sm occasion-input text-center" min="0" max="100" step="1"></td>
                    <td class="text-center"><input type="number" name="<%= subject.key %>_cat2" class="form-control form-control-sm occasion-input text-center" min="0" max="100" step="1"></td>
                    <td class="text-center"><input type="number" name="<%= subject.key %>_main" class="form-control form-control-sm occasion-input text-center" min="0" max="100" step="1"></td>
                    <td class="text-center"><input type="text" class="form-control form-control-sm final-mark text-center" data-subject="<%= subject.key %>" readonly></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="row align-items-center mt-4">
          <div class="col-12 col-md-8">
            <div class="alert alert-info mb-0">
              <strong>Score formula:</strong> CAT1/100×15 + CAT2/100×15 + Main Exam/100×70. Final marks appear live as you type.
            </div>
          </div>
          <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
            <div class="d-flex justify-content-end gap-2">
              <button type="button" id="clearAllBtn" class="btn btn-outline-danger px-4">Clear All Fields</button>
              <button type="submit" class="btn btn-primary px-4 w-100 w-md-auto">Save Result</button>
            </div>
          </div>
        </div>
      </form>

      <% const examSubjectsData = subjectDefinitions && subjectDefinitions.length ? subjectDefinitions : [
          { key: 'english', label: 'English' },
          { key: 'kiswahili', label: 'Kiswahili' },
          { key: 'mathematics', label: 'Mathematics' },
          { key: 'integrated_science', label: 'Integrated Science' },
          { key: 'agriculture', label: 'Agriculture' },
          { key: 'social_studies', label: 'Social Studies' },
          { key: 'cre', label: 'CRE' },
          { key: 'pre_technical', label: 'Pre-Technical' },
          { key: 'creative_arts', label: 'Creative Arts' }
        ]; %>
      <script>
        const learnersData = <%- JSON.stringify(learners || []) %>;
        const examSubjects = <%- JSON.stringify(examSubjectsData) %>;
        const gradeValue = "<%= grade || '' %>";
        const selectedTermValue = "<%= selectedTerm %>";
        const assessmentTypeValue = "<%= assessmentType || 'continous' %>";
        const learnerSelect = document.querySelector('[name="learner_id"]');
        const gradeSelect = document.getElementById('gradeSelect');
        const gradeInput = document.querySelector('input[name="grade"]');
        const subjectSelect = document.getElementById('subjectSelect');
        const addSubjectBtn = document.getElementById('addSubjectBtn');
        const selectedSubjectInputs = document.getElementById('selectedSubjectInputs');

        const subjectKeys = () => examSubjects.map(subject => subject.key);

        const setRowState = (row, enabled) => {
          row.hidden = !enabled;
          row.querySelectorAll('input').forEach(input => {
            input.disabled = !enabled;
            if (!enabled) input.value = '';
          });
        };

        const subjectButtonList = document.getElementById('subjectButtonList');

        const syncSelectedSubjectInputs = activeKeys => {
          if (!selectedSubjectInputs) return;
          selectedSubjectInputs.innerHTML = activeKeys.map(key => `<input type="hidden" name="selected_subjects[]" value="${key}">`).join('');
        };

        const activeSubjectKeys = () => Array.from(document.querySelectorAll('.subject-row:not([hidden])')).map(row => row.dataset.subject);

        const renderSubjectButtons = () => {
          if (!subjectButtonList) return;
          const activeKeys = activeSubjectKeys();
          subjectButtonList.innerHTML = activeKeys.map(key => {
            const subject = examSubjects.find(subject => subject.key === key);
            const label = subject ? subject.label : key;
            return `
              <button type="button" class="btn btn-sm btn-outline-danger subject-pill" data-subject="${key}">
                ${label} <span aria-hidden="true">&times;</span>
              </button>
            `;
          }).join('');
          document.querySelectorAll('.subject-pill').forEach(button => {
            button.addEventListener('click', () => removeSubjectRow(button.dataset.subject));
          });
        };

        const updateSubjectOptions = () => {
          if (!subjectSelect) return;
          const selectedValue = subjectSelect.value;
          const hiddenSubjects = examSubjects.filter(subject => {
            const row = document.querySelector(`.subject-row[data-subject="${subject.key}"]`);
            return row && row.hidden;
          });

          subjectSelect.innerHTML = '<option value="">Add a Learning Area</option>';
          hiddenSubjects.forEach(subject => {
            const option = document.createElement('option');
            option.value = subject.key;
            option.textContent = subject.label;
            if (subject.key === selectedValue) {
              option.selected = true;
            }
            subjectSelect.appendChild(option);
          });

          if (selectedValue && !hiddenSubjects.some(subject => subject.key === selectedValue)) {
            subjectSelect.value = '';
          }
          addSubjectBtn.disabled = hiddenSubjects.length === 0 || !subjectSelect.value;
        };

        const updateSubjectState = (shouldSave = true) => {
          syncSelectedSubjectInputs(activeSubjectKeys());
          updateSubjectOptions();
          renderSubjectButtons();
          if (shouldSave) saveFormState();
        };

        const initializeSubjectRows = () => {
          examSubjects.forEach(subject => {
            const row = document.querySelector(`.subject-row[data-subject="${subject.key}"]`);
            if (!row) return;
            setRowState(row, false);
          });
          updateSubjectState(false);
        };

        const removeSubjectRow = key => {
          const row = document.querySelector(`.subject-row[data-subject="${key}"]`);
          if (!row) return;
          setRowState(row, false);
          updateFinal();
          updateSubjectState();
        };

        const addSubjectRow = key => {
          const row = document.querySelector(`.subject-row[data-subject="${key}"]`);
          if (!row) return;
          setRowState(row, true);
          updateSubjectState();
        };

        const parseScore = value => {
          if (value === '' || value === null || value === undefined) return null;
          const n = Number(value);
          return Number.isFinite(n) ? n : null;
        };

        const clampMarkInput = input => {
          if (!input) return;
          const value = input.value;
          if (value === '' || value === null || value === undefined) return;
          const n = Number(value);
          if (!Number.isFinite(n)) {
            input.value = '';
            return;
          }
          if (n < 0) {
            input.value = '0';
          } else if (n > 100) {
            input.value = '100';
          }
        };

        const getFinalMark = (cat1, cat2, main) => {
          if (cat1 === null && cat2 === null && main === null) return null;
          const scoreCat1 = cat1 || 0;
          const scoreCat2 = cat2 || 0;
          const scoreMain = main || 0;
          return Math.round((scoreCat1 / 100 * 15) + (scoreCat2 / 100 * 15) + (scoreMain / 100 * 70));
        };

        const getStateKey = (learnerId = null) => {
          const id = learnerId !== null ? learnerId : (learnerSelect ? learnerSelect.value || 'none' : 'none');
          return `exam_add_${gradeValue}_${selectedTermValue}_${assessmentTypeValue}_${id}`;
        };

        const collectDynamicEntryState = () => {
          const dynamicEntries = {};
          examSubjects.forEach(subject => {
            const subjectKey = subject.key;
            const strandList = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
            const subList = document.querySelector(`.substrand-list[data-subject="${subjectKey}"]`);
            const draftStrandInput = document.querySelector(`input[name="${subjectKey}_strand"]`);
            const draftSubstrandInput = document.querySelector(`.substrand-input[data-subject="${subjectKey}"]`);
            dynamicEntries[subjectKey] = {
              drafts: {
                strand: draftStrandInput ? draftStrandInput.value : '',
                substrand: draftSubstrandInput ? draftSubstrandInput.value : ''
              },
              strands: strandList
                ? Array.from(strandList.querySelectorAll('.strand-item input[type="hidden"][name="' + subjectKey + '_strand[]"]')).map(input => input.value)
                : [],
              substrands: subList
                ? Array.from(subList.querySelectorAll('.substrand-item')).map((item, idx) => {
                    const entryId = item.dataset.entryId || `${subjectKey}_line_${idx + 1}`;
                    const hiddenInput = item.querySelector('input[type="hidden"]');
                    return {
                      text: hiddenInput ? hiddenInput.value : '',
                      ee: document.querySelector(`input[name="${entryId}_ee"]`)?.checked || false,
                      ae: document.querySelector(`input[name="${entryId}_ae"]`)?.checked || false,
                      me: document.querySelector(`input[name="${entryId}_me"]`)?.checked || false,
                      be: document.querySelector(`input[name="${entryId}_be"]`)?.checked || false,
                      reflection: document.querySelector(`textarea[name="${entryId}_reflection"]`)?.value || '',
                      parentStrandIndex: item.dataset.parentStrandIndex || null
                    };
                  })
                : []
            };
          });
          return dynamicEntries;
        };

        const restoreDynamicEntryState = (dynamicEntries = {}) => {
          examSubjects.forEach(subject => {
            const subjectKey = subject.key;
            const strandList = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
            const subList = document.querySelector(`.substrand-list[data-subject="${subjectKey}"]`);
            const reflectionList = document.querySelector(`.substrand-reflection-list[data-subject="${subjectKey}"]`);
            const checklistContainers = ['ee','ae','me','be'].map(type => document.querySelector(`.substrand-checklist[data-subject="${subjectKey}"][data-type="${type}"]`));

            if (!strandList || !subList) return;

            strandList.innerHTML = '';
            subList.innerHTML = '';
            checklistContainers.forEach(container => {
              if (container) container.innerHTML = '';
            });
            if (reflectionList) reflectionList.innerHTML = '';

            const savedEntrySet = dynamicEntries[subjectKey] || {};
            const savedStrands = Array.isArray(savedEntrySet.strands) ? savedEntrySet.strands : [];
            const savedSubstrands = Array.isArray(savedEntrySet.substrands) ? savedEntrySet.substrands : [];

            strandList.dataset.strandIndex = String(savedStrands.length);
            savedStrands.forEach((value, index) => {
              const item = document.createElement('div');
              item.className = 'strand-item border rounded';
              item.dataset.entryId = `${subjectKey}_strand_${index + 1}`;
              item.innerHTML = `<div class="entry-text small fw-semibold">${toRoman(index + 1)}. ${escapeHtml(value)}</div>`;
              const hidden = document.createElement('input');
              hidden.type = 'hidden';
              hidden.name = `${subjectKey}_strand[]`;
              hidden.value = value;
              item.appendChild(hidden);
              strandList.appendChild(item);
              bindEditAction(item, { subjectKey, kind: 'strand', entryId: item.dataset.entryId, label: toRoman(index + 1) });
            });

            subList.dataset.substrandIndex = String(savedSubstrands.length);
            const draftStrandInput = document.querySelector(`input[name="${subjectKey}_strand"]`);
            const draftSubstrandInput = document.querySelector(`.substrand-input[data-subject="${subjectKey}"]`);
            if (draftStrandInput && typeof savedEntrySet.drafts?.strand === 'string') {
              draftStrandInput.value = savedEntrySet.drafts.strand;
            }
            if (draftSubstrandInput && typeof savedEntrySet.drafts?.substrand === 'string') {
              draftSubstrandInput.value = savedEntrySet.drafts.substrand;
            }
            savedSubstrands.forEach((entry, index) => {
              const item = document.createElement('div');
              const entryId = `${subjectKey}_line_${index + 1}`;
              item.className = 'substrand-item border rounded';
              item.dataset.entryId = entryId;
              item.innerHTML = `<div class="entry-text small fw-semibold">${toRoman(index + 1)}. ${escapeHtml(entry.text || '')}</div>`;
              const hidden = document.createElement('input');
              hidden.type = 'hidden';
              hidden.name = `${entryId}_text`;
              hidden.value = entry.text || '';
              item.appendChild(hidden);
              subList.appendChild(item);
              bindEditAction(item, { subjectKey, kind: 'substrand', entryId, label: toRoman(index + 1) });

              // attempt to preserve or assign a parent strand color
              const strandList = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
              const strandCount = strandList ? strandList.querySelectorAll('.strand-item').length : 0;
              const parentIndex = (entry.parentStrandIndex && Number(entry.parentStrandIndex)) || (strandCount > 0 ? strandCount : (index + 1));
              const colorIndex = ((parentIndex - 1) % 2) + 1;
              item.dataset.parentStrandIndex = String(parentIndex);
              item.classList.add(`strand-color-${colorIndex}`);

              ['ee','ae','me','be'].forEach(type => {
                const container = document.querySelector(`.substrand-checklist[data-subject="${subjectKey}"][data-type="${type}"]`);
                if (!container) return;
                const wrap = document.createElement('div');
                wrap.className = 'substrand-cell border rounded mb-2';
                wrap.dataset.entryId = entryId;
                const cb = document.createElement('input');
                cb.type = 'checkbox';
                cb.name = `${entryId}_${type}`;
                cb.value = '1';
                cb.checked = !!(entry && entry[type]);
                wrap.appendChild(cb);
                container.appendChild(wrap);
              });

              if (reflectionList) {
                const wrap = document.createElement('div');
                wrap.className = 'reflection-cell border rounded mb-2';
                wrap.dataset.entryId = entryId;
                const ta = document.createElement('textarea');
                ta.className = 'substrand-reflection-input';
                ta.name = `${entryId}_reflection`;
                ta.rows = 1;
                ta.placeholder = 'Reflection';
                ta.value = entry.reflection || '';
                wrap.appendChild(ta);
                reflectionList.appendChild(wrap);
              }
            });
            syncSubstrandEntryHeights(subjectKey);
          });
        };

        const saveFormState = () => {
          const state = {
            learner_id: learnerSelect ? learnerSelect.value : null,
            activeSubjects: activeSubjectKeys(),
            values: {},
            dynamicEntries: collectDynamicEntryState()
          };
          subjectKeys().forEach(subject => {
            state.values[`${subject}_cat1`] = document.querySelector(`input[name="${subject}_cat1"]`)?.value || '';
            state.values[`${subject}_cat2`] = document.querySelector(`input[name="${subject}_cat2"]`)?.value || '';
            state.values[`${subject}_main`] = document.querySelector(`input[name="${subject}_main"]`)?.value || '';
          });
          localStorage.setItem(getStateKey(), JSON.stringify(state));
        };

        const findSavedState = () => {
          return localStorage.getItem(getStateKey());
        };

        const loadFormState = () => {
          const saved = findSavedState();
          if (!saved) return false;
          try {
            const state = JSON.parse(saved);
            if (learnerSelect && state.learner_id && learnerSelect.querySelector(`option[value="${state.learner_id}"]`)) {
              learnerSelect.value = state.learner_id;
            }
            const activeSubjects = Array.isArray(state.activeSubjects)
              ? state.activeSubjects
              : subjectKeys().filter(subject => {
                  return (state.values && (
                    state.values[`${subject}_cat1`] ||
                    state.values[`${subject}_cat2`] ||
                    state.values[`${subject}_main`]
                  ));
                });
            subjectKeys().forEach(subject => {
              const row = document.querySelector(`.subject-row[data-subject="${subject}"]`);
              const cat1 = document.querySelector(`input[name="${subject}_cat1"]`);
              const cat2 = document.querySelector(`input[name="${subject}_cat2"]`);
              const main = document.querySelector(`input[name="${subject}_main"]`);
              if (!cat1 || !cat2 || !main || !row) return;
              const isActive = activeSubjects.includes(subject);
              setRowState(row, isActive);
              cat1.value = (state.values && state.values[`${subject}_cat1`]) || '';
              cat2.value = (state.values && state.values[`${subject}_cat2`]) || '';
              main.value = (state.values && state.values[`${subject}_main`]) || '';
            });
            restoreDynamicEntryState(state.dynamicEntries || {});
            updateFinal();
            updateSubjectState();
            return true;
          } catch (err) {
            console.error('Failed to restore form state', err);
            return false;
          }
        };

        const updateFinal = () => {
          subjectKeys().forEach(subject => {
            const cat1 = document.querySelector(`input[name="${subject}_cat1"]`);
            const cat2 = document.querySelector(`input[name="${subject}_cat2"]`);
            const main = document.querySelector(`input[name="${subject}_main"]`);
            const finalField = document.querySelector(`.final-mark[data-subject="${subject}"]`);
            if (!cat1 || !cat2 || !main || !finalField) return;
            const finalMark = getFinalMark(parseScore(cat1.value), parseScore(cat2.value), parseScore(main.value));
            finalField.value = finalMark === null ? '' : finalMark;
          });
        };

        const populateLearnerScores = learnerId => {
          const learner = learnersData.find(l => String(l.id) === String(learnerId) || String(l.learner_id) === String(learnerId));
          restoreDynamicEntryState({});
          subjectKeys().forEach(subject => {
            const row = document.querySelector(`.subject-row[data-subject="${subject}"]`);
            const cat1 = document.querySelector(`input[name="${subject}_cat1"]`);
            const cat2 = document.querySelector(`input[name="${subject}_cat2"]`);
            const main = document.querySelector(`input[name="${subject}_main"]`);
            if (!cat1 || !cat2 || !main || !row) return;
            if (learner) {
              const saved = learner.subjectRows && learner.subjectRows[subject];
              const savedCat1 = saved?.cat1 ?? learner[`${subject}_cat1`] ?? '';
              const savedCat2 = saved?.cat2 ?? learner[`${subject}_cat2`] ?? '';
              const savedMain = saved?.main ?? learner[`${subject}_main`] ?? '';
              cat1.value = savedCat1;
              cat2.value = savedCat2;
              main.value = savedMain;

              const hasContinuousData = !!(saved && (saved.strand || saved.sub_strand || saved.reflection || saved.ee || saved.ae || saved.me || saved.be));
              if (hasContinuousData) {
                // Build a dynamicEntries structure and reuse restoreDynamicEntryState
                const dynamicEntries = {};
                dynamicEntries[subject] = {
                  drafts: {
                    strand: '',
                    substrand: ''
                  },
                  strands: saved.strand ? String(saved.strand).split('\n').map(s => s.trim()).filter(Boolean) : [],
                  substrands: []
                };

                // Keep every stored value aligned with its substrand index.
                const splitSavedValues = value => value === null || value === undefined || value === ''
                  ? []
                  : String(value).split('\n');
                const substrandLines = splitSavedValues(saved.sub_strand);
                const reflectionLines = splitSavedValues(saved.reflection);
                const checkLines = {
                  ee: splitSavedValues(saved.ee),
                  ae: splitSavedValues(saved.ae),
                  me: splitSavedValues(saved.me),
                  be: splitSavedValues(saved.be)
                };
                const entryCount = Math.max(
                  substrandLines.length,
                  reflectionLines.length,
                  ...Object.values(checkLines).map(lines => lines.length)
                );
                if (entryCount > 0) {
                  Array.from({ length: entryCount }, (_, idx) => {
                    dynamicEntries[subject].substrands.push({
                      text: (substrandLines[idx] || '').trim(),
                      ee: checkLines.ee[idx] === '1',
                      ae: checkLines.ae[idx] === '1',
                      me: checkLines.me[idx] === '1',
                      be: checkLines.be[idx] === '1',
                      reflection: reflectionLines[idx] || '',
                      parentStrandIndex: saved.strand ? Math.min(idx + 1, String(saved.strand).split('\n').length) : null
                    });
                  });
                } else if (saved.sub_strand || saved.reflection || saved.ee || saved.ae || saved.me || saved.be) {
                  // single fallback entry
                  dynamicEntries[subject].substrands.push({
                    text: saved.sub_strand || '',
                    ee: saved.ee === '1' || saved.ee === true,
                    ae: saved.ae === '1' || saved.ae === true,
                    me: saved.me === '1' || saved.me === true,
                    be: saved.be === '1' || saved.be === true,
                    reflection: saved.reflection || '',
                    parentStrandIndex: saved.strand ? 1 : null
                  });
                }

                try {
                  restoreDynamicEntryState(dynamicEntries);
                } catch (e) {
                  console.warn('Could not restore dynamic continuous entries for', subject, e);
                }
              }

              if (saved || cat1.value || cat2.value || main.value) {
                setRowState(row, true);
              }
            } else {
              cat1.value = '';
              cat2.value = '';
              main.value = '';
            }
          });
          updateFinal();
          updateSubjectState();
          saveFormState();
        };

        const changeGrade = () => {
          const selectedGrade = gradeSelect?.value || gradeValue || '1';
          if (gradeInput) {
            gradeInput.value = selectedGrade;
          }
          const params = new URLSearchParams(window.location.search);
          params.set('grade', selectedGrade);
          params.set('term', selectedTermValue);
          window.location.href = `${window.location.pathname}?${params.toString()}`;
        };

        if (learnerSelect) {
          learnerSelect.addEventListener('change', event => {
            const learnerId = event.target.value;
            const params = new URLSearchParams(window.location.search);
            if (learnerId) {
              params.set('learner_id', learnerId);
            } else {
              params.delete('learner_id');
            }
            params.set('grade', gradeSelect?.value || gradeValue || '');
            params.set('term', selectedTermValue);
            params.set('assessment', assessmentTypeValue);
            history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
            populateLearnerScores(learnerId);
          });
        }

        gradeSelect?.addEventListener('change', changeGrade);
        subjectSelect?.addEventListener('change', updateSubjectOptions);

        addSubjectBtn?.addEventListener('click', () => {
          const subjectKey = subjectSelect?.value;
          if (!subjectKey) return;
          addSubjectRow(subjectKey);
          if (subjectSelect) subjectSelect.value = '';
          updateSubjectOptions();
        });

        document.querySelectorAll('.remove-subject-btn').forEach(button => {
          button.addEventListener('click', () => removeSubjectRow(button.dataset.subject));
        });


        // Sub-strand editor: add entries with Roman numbering and wire checkboxes/reflections
        const toRoman = num => {
          if (!Number.isInteger(num) || num <= 0) return String(num);
          const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
          const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
          let res = '';
          for (let i=0;i<vals.length;i++){
            while (num>=vals[i]){ res += syms[i]; num -= vals[i]; }
          }
          return res.toLowerCase();
        };

        const escapeHtml = s => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

        const renumberStrandEntries = subjectKey => {
          const list = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
          if (!list) return;
          const items = Array.from(list.querySelectorAll('.strand-item'));
          items.forEach((item, index) => {
            const label = toRoman(index + 1);
            const hidden = item.querySelector('input[type="hidden"]');
            const textNode = item.querySelector('.entry-text');
            const value = hidden ? hidden.value : '';
            item.dataset.entryId = `${subjectKey}_strand_${index + 1}`;
            item.dataset.label = label;
            // apply a persistent color class based on strand order (1-2 cycle)
            const colorIndex = ((index) % 2) + 1;
            item.dataset.strandIndex = String(index + 1);
            item.classList.remove(...Array.from(item.classList).filter(c => c.startsWith('strand-color-')));
            item.classList.add(`strand-color-${colorIndex}`);
            if (hidden) hidden.name = `${subjectKey}_strand[]`;
            if (textNode) textNode.innerHTML = `${label}. ${escapeHtml(value)}`;
          });
          list.dataset.strandIndex = String(items.length);
        };

        const renumberSubstrandEntries = subjectKey => {
          const list = document.querySelector(`.substrand-list[data-subject="${subjectKey}"]`);
          if (!list) return;
          const items = Array.from(list.querySelectorAll('.substrand-item'));
          const oldIds = items.map(item => item.dataset.entryId || '');
          items.forEach((item, index) => {
            const label = toRoman(index + 1);
            const newEntryId = `${subjectKey}_line_${index + 1}`;
            const hidden = item.querySelector('input[type="hidden"]');
            const textNode = item.querySelector('.entry-text');
            const value = hidden ? hidden.value : '';
            item.dataset.entryId = newEntryId;
            item.dataset.label = label;
            // determine color from explicit parentStrandIndex if present (1-2 cycle)
            const parentIndexRaw = item.dataset.parentStrandIndex;
            const parentIndex = parentIndexRaw ? Number(parentIndexRaw) : null;
            const colorIndex = parentIndex ? (((parentIndex - 1) % 2) + 1) : (((index) % 2) + 1);
            // normalize classes
            item.classList.remove(...Array.from(item.classList).filter(c => c.startsWith('strand-color-')));
            item.classList.add(`strand-color-${colorIndex}`);
            if (hidden) hidden.name = `${newEntryId}_text`;
            if (textNode) textNode.innerHTML = `${label}. ${escapeHtml(value)}`;
          });

          oldIds.forEach((oldId, index) => {
            if (!oldId) return;
            const newEntryId = `${subjectKey}_line_${index + 1}`;
            document.querySelectorAll(`.substrand-checklist[data-subject="${subjectKey}"] .substrand-cell[data-entry-id="${oldId}"]`).forEach(cell => {
              const checkbox = cell.querySelector('input[type="checkbox"]');
              cell.dataset.entryId = newEntryId;
              const checklistType = cell.closest('.substrand-checklist')?.dataset.type || 'ee';
              if (checkbox) checkbox.name = `${newEntryId}_${checklistType}`;
            });
            document.querySelectorAll(`.substrand-reflection-list[data-subject="${subjectKey}"] .reflection-cell[data-entry-id="${oldId}"]`).forEach(cell => {
              cell.dataset.entryId = newEntryId;
              const textarea = cell.querySelector('textarea');
              if (textarea) textarea.name = `${newEntryId}_reflection`;
            });
          });

          list.dataset.substrandIndex = String(items.length);
        };

        // const clearStrandEntries = subjectKey => {
        //   const list = document.querySelector(`.strand-list[data-subject="${subjectKey}"]`);
        //   const input = document.querySelector(`input[name="${subjectKey}_strand"]`);
        //   if (list) {
