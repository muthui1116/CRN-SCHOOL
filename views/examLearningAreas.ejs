<%- include('partials/header') %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">

<main class="container py-4 py-md-5">
  <div class="mb-4">
    <a href="/exams?grade=<%= selectedGrade %>&term=<%= selectedTerm %>" class="btn btn-sm btn-outline-secondary mb-3">
      <i class="fas fa-arrow-left me-1"></i>Back to results
    </a>
    <h1 class="h4 mb-1">Notes Grade <%= selectedGrade %></h1>
    <p class="text-muted mb-0">Term <%= selectedTerm %></p>
  </div>

  <section class="bg-white border rounded p-3 p-md-4" aria-labelledby="learningAreaHeading">
    <h2 id="learningAreaHeading" class="h6 fw-semibold mb-3">Select a learning area</h2>
    <form method="GET" action="/exams/learning-areas" class="mb-4">
      <input type="hidden" name="grade" value="<%= selectedGrade %>">
      <input type="hidden" name="term" value="<%= selectedTerm %>">
      <select id="learningAreaSelect" name="subject_code" class="form-select" aria-label="Learning area" onchange="this.form.submit()">
        <option value="">Choose a learning area</option>
        <% learningAreas.forEach(area => { %>
          <option value="<%= area.subject_code %>" <%= selectedSubjectCode === area.subject_code ? 'selected' : '' %>><%= area.name %></option>
        <% }); %>
      </select>
    </form>

    <% if (saved) { %>
      <div class="alert alert-success py-2" role="status">Lesson notes saved.</div>
    <% } %>
    <% if (invalid) { %>
      <div class="alert alert-danger py-2" role="alert">Complete all fields with valid values before saving.</div>
    <% } %>

    <% if (selectedArea) { %>
      <% if (lessonNotes.length) { %>
        <div class="mb-4">
          <h3 class="h6 fw-semibold mb-3">Saved lessons</h3>
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr><th>Week</th><th>Lesson</th><th>Strand</th><th>Sub-Strand</th><th class="text-end">Download</th></tr>
              </thead>
              <tbody>
                <% lessonNotes.forEach(note => { %>
                  <tr>
                    <td><%= note.week_no %></td>
                    <td><%= note.lesson_no %></td>
                    <td><%= note.strand %></td>
                    <td><%= note.sub_strand %></td>
                    <td class="text-end">
                      <a href="/exams/lesson-notes/<%= note.id %>/download" class="btn btn-sm btn-outline-secondary" aria-label="Download week <%= note.week_no %> lesson <%= note.lesson_no %>">
                        <i class="fas fa-download me-1"></i>Download
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <form action="/exams/learning-areas" method="POST" id="lessonNoteForm">
        <input type="hidden" name="grade" value="<%= selectedGrade %>">
        <input type="hidden" name="term" value="<%= selectedTerm %>">
        <input type="hidden" name="subject_code" value="<%= selectedSubjectCode %>">
        <input type="hidden" name="lesson_content" id="lessonContentInput">

        <div class="mb-3">
          <h3 class="h5 mb-0"><%= selectedArea.name %></h3>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-12 col-md-3">
            <label for="strand" class="form-label">Strand</label>
            <input id="strand" name="strand" class="form-control" maxlength="255" required>
          </div>
          <div class="col-12 col-md-3">
            <label for="subStrand" class="form-label">Sub-Strand</label>
            <input id="subStrand" name="sub_strand" class="form-control" required>
          </div>
          <div class="col-12 col-md-3">
            <label for="weekNo" class="form-label">Week</label>
            <input id="weekNo" name="week_no" type="number" min="1" step="1" class="form-control" required>
          </div>
          <div class="col-12 col-md-3">
            <label for="lessonNo" class="form-label">Lesson No.</label>
            <input id="lessonNo" name="lesson_no" type="number" min="1" step="1" class="form-control" required>
          </div>
        </div>

        <label class="form-label" for="editor">Lesson Notes</label>
        <div id="toolbar" aria-label="Text formatting toolbar">
          <span class="ql-formats">
            <select class="ql-font"></select>
            <select class="ql-size"></select>
          </span>
          <span class="ql-formats">
            <button class="ql-bold"></button><button class="ql-italic"></button><button class="ql-underline"></button><button class="ql-strike"></button>
          </span>
          <span class="ql-formats">
            <select class="ql-color"></select><select class="ql-background"></select>
            <button class="ql-script" value="sub"></button><button class="ql-script" value="super"></button>
          </span>
          <span class="ql-formats">
            <select class="ql-header">
              <option value="1"></option><option value="2"></option><option value="3"></option><option selected></option>
            </select>
            <button class="ql-blockquote"></button><button class="ql-code-block"></button>
          </span>
          <span class="ql-formats">
            <button class="ql-list" value="ordered"></button><button class="ql-list" value="bullet"></button>
            <button class="ql-indent" value="-1"></button><button class="ql-indent" value="+1"></button>
          </span>
          <span class="ql-formats">
            <select class="ql-align"></select><select class="ql-direction" value="rtl"></select>
          </span>
          <span class="ql-formats">
            <button class="ql-link"></button><button class="ql-image"></button><button class="ql-clean"></button>
          </span>
        </div>
        <div id="editor" class="bg-white" data-content="<%= JSON.stringify({ ops: [] }) %>"></div>

        <div class="d-flex justify-content-end mt-3">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save lesson notes</button>
        </div>
      </form>
    <% } %>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  const editorElement = document.getElementById('editor');
  if (editorElement) {
    const editor = new Quill(editorElement, {
      theme: 'snow',
      modules: { toolbar: '#toolbar' },
      placeholder: 'Write lesson notes...'
    });

    try {
      editor.setContents(JSON.parse(editorElement.dataset.content));
    } catch {
      editor.setText('');
    }

    document.getElementById('lessonNoteForm').addEventListener('submit', () => {
      document.getElementById('lessonContentInput').value = JSON.stringify(editor.getContents());
    });
  }
</script>